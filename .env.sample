# https://github.com/ddollar/forego
ASSET_HOST=localhost:3000
APPLICATION_HOST=localhost:3000
PORT=3000
RACK_ENV=development
RACK_MINI_PROFILER=0
SECRET_KEY_BASE=development_secret
EXECJS_RUNTIME=Node
SMTP_ADDRESS=smtp.sendgrid.com
SMTP_DOMAIN=darryndollars.com
SMTP_PASSWORD=password
SMTP_USERNAME=apikey
WEB_CONCURRENCY=1

# Sports shown on the lines board. Set to 0 to take one off the board; the
# scrape keeps running, so switching it back on is immediate.
NCAAF_ENABLED=1
NFL_ENABLED=1
