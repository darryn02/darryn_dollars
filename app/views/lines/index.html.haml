%h1.dd-page-title Lines

= render "scope_nav"

- if @games.empty?
  .blank-state
    = icon "emoji-frown"
    %h2= "No #{@scope.to_s.titleize} Lines Right Now"
    %p Check back a bit closer to kickoff.
- else
  .dd-board
    -# Once at the top of the board, not inside _game - that partial renders
    -# per game card, so a header there repeats above every game on the slate.
    -# Two columns were survivable unlabelled; three are not.
    - if moneyline_column?
      .dd-board__header{ "aria-hidden" => "true" }
        %span
        %span Spread
        %span Total
        %span ML
    - @games.each do |game_lines|
      = render "game", game_lines: game_lines

  -# Bet forms sit outside the board so the offcanvas markup never lands
  -# inside a row's grid.
  - @games.each do |game_lines|
    - game_lines.bet_lines.each do |line|
      = render "bet_form", line: line, user: current_user, game_lines: game_lines
