.offcanvas.offcanvas-bottom.dd-bet-sheet{ id: "betOffcanvas-#{line.id}", tabindex: "-1", "aria-labelledby" => "betOffcanvasLabel-#{line.id}" }
  .offcanvas-header
    .dd-bet-sheet__heading
      %h2.offcanvas-title{ id: "betOffcanvasLabel-#{line.id}" }= line_headline(line)
      %p.dd-bet-sheet__meta
        = game_lines.matchup_label
        %span.dd-bet-sheet__dot &middot;
        = game_lines.kickoff_label
        %span.dd-bet-sheet__dot &middot;
        = line_terms(line)
    %button.btn-close{ data: { bs_dismiss: "offcanvas" }, "aria-label" => "Close" }
  .offcanvas-body
    .bet-form
      = simple_form_for(Wager.new(line_id: line.id), remote: true) do |f|
        = f.input :line_id, as: :hidden, value: line.id

        - if accounts.many?
          -# Enter in a field presses a form's first submit button. Here that
          -# would be the first account's - a default nobody chose, which is
          -# what the per-account buttons below exist to remove. A disabled
          -# first submit button means Enter submits nothing.
          %button{ type: "submit", disabled: true, hidden: true, tabindex: "-1", "aria-hidden" => "true" }
        - else
          = f.hidden_field :account_id, value: accounts.first.id

        .dd-quick-amounts{ role: "group", "aria-label" => "Quick amounts" }
          - quick_wager_amounts.each do |amount|
            %button.dd-quick-amount.js-quick-amount{ type: "button", data: { amount: amount } }
              = number_to_currency(amount, precision: 0)

        .dd-bet-fields
          = f.input :amount, as: :string, label: "Amount",
            input_html: { class: "js-wager-amount-bet", inputmode: "decimal",
                          autocomplete: "off", placeholder: "$0.00",
                          data: { type: "currency", odds: "#{line.odds}" } }
          = f.input :to_win, as: :string, label: "To win",
            input_html: { class: "js-wager-to-win", inputmode: "decimal",
                          autocomplete: "off", placeholder: "$0.00",
                          data: { type: "currency", odds: "#{line.odds}" } }

        - if accounts.many?
          -# One submit per account and no account chosen in advance. This was
          -# a dropdown preselected to the first account, and a bet for the
          -# other one meant remembering to change it every time.
          .dd-bet-as{ role: "group", "aria-labelledby" => "betAsLabel-#{line.id}" }
            %p.dd-bet-as__label{ id: "betAsLabel-#{line.id}" } Add this bet for
            .dd-bet-as__choices
              - accounts.each do |account|
                -# data-disable is what f.submit gets for free: jquery_ujs
                -# disables every such button once the request is sent, so a
                -# second tap before the sheet closes cannot add the bet
                -# again - on this account or, by a slip of the thumb, the
                -# other. Plain data-disable rather than data-disable-with,
                -# which would swap the avatar and name for a line of text.
                %button.dd-bet-as__btn{ type: "submit", name: "wager[account_id]", value: account.id,
                  class: account_color_class(account), data: { disable: true } }
                  = account_avatar(account)
                  %span.dd-bet-as__who
                    %span.dd-bet-as__name= account.display_name
                    %span.dd-bet-as__credit= "#{number_to_currency(available_credit(account), precision: 0)} available"
        - else
          = f.submit "Add to Bet Slip", class: "btn btn-primary dd-bet-submit"
