<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="ROBOTS" content="NOODP" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <meta name="theme-color" content="#061A5C" />
  <title><%= title %></title>
  <%= stylesheet_link_tag :application, "data-turbo-track": "reload", media: "all" %>
  <%= csrf_meta_tags %>
  <%= javascript_importmap_tags %>
</head>
<body class="<%= body_class %>">
  <%= render "icon_sprite" %>

  <nav class="navbar dd-topbar" aria-label="Account">
    <div class="container-fluid">
      <%= link_to root_path, class: "dd-brand" do %>
        <%= image_tag "logo.png", class: "dd-brand__mark", alt: "", width: 175, height: 212 %>
        <span>Darryn Dollars</span>
      <% end %>

      <% if current_user.present? %>
        <div class="nav-item dropdown dd-user-menu">
          <button class="btn dropdown-toggle" type="button" id="navbarScrollingDropdown"
                  data-bs-toggle="dropdown" aria-expanded="false">
            <span class="dd-avatar" aria-hidden="true"><%= current_user.name.split.map(&:first).first(2).join %></span>
            <span class="visually-hidden"><%= current_user.name %></span>
          </button>
          <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="navbarScrollingDropdown">
            <li>
              <%= link_to edit_user_path(current_user), class: "dropdown-item" do %>
                <%= icon "gear", css_class: "me-2" %>Settings
              <% end %>
            </li>
            <li><hr class="dropdown-divider"></li>
            <li>
              <%= link_to destroy_user_session_path, method: :delete, class: "dropdown-item" do %>
                <%= icon "box-arrow-right", css_class: "me-2" %>Sign Out
              <% end %>
            </li>
          </ul>
        </div>
      <% end %>
    </div>
  </nav>

  <%= render "flashes" %>

  <main class="main container">
    <%= yield %>
  </main>

  <%= render "bottom_nav" if current_user.present? %>

  <div class="dd-loading" role="status" aria-live="polite">
    <div class="dd-spinner"></div>
    <p>Getting the latest information. Please be patient&hellip;</p>
  </div>

  <%= render "javascript" %>
  <%= render "css_overrides" %>
</body>
</html>
