<% url = edit_password_url(@resource, reset_password_token: @token) %>
<p>Hello <%= @resource.email %>!</p>

<p>Someone requested a password reset for your Darryn Dollars account.
   You can set a new one here:</p>

<p><%= link_to "Change my password", url %></p>

<p>If that link doesn't work, copy and paste this address into your browser:<br>
   <%= url %></p>

<p>If you didn't request this, you can ignore this email. Your password
   won't change until you open the link above and set a new one.</p>

<p>Darryn Dollars &mdash; <%= link_to "www.darryndollars.com", root_url %></p>
