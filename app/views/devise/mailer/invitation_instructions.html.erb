<p>You've been invited to Darryn Dollars!</p>

<p>Click the link below to set up your name and password and join:</p>

<p><%= link_to 'Accept invitation', accept_invitation_url(@resource, invitation_token: @token) %></p>

<% if @resource.invitation_due_at %>
  <p>This invitation is due to expire on <%= @resource.invitation_due_at.strftime("%B %-d, %Y") %>.</p>
<% end %>
