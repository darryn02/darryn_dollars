<div class="dd-auth">
  <div class="dd-auth__card">
    <h1 class="dd-auth__title">Forgot your password?</h1>
    <p class="dd-auth__lead">We'll email you a link to set a new one.</p>

    <%= simple_form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post }) do |f| %>
      <%= f.error_notification %>

      <%= f.input :email,
                  required: true,
                  autofocus: true,
                  input_html: { autocomplete: "email", inputmode: "email" } %>

      <%= f.button :submit, "Send reset instructions", class: "btn btn-primary w-100 dd-auth__submit" %>
    <% end %>

    <div class="dd-auth__links">
      <%= render "devise/shared/links" %>
    </div>
  </div>
</div>
