<div class="dd-auth">
  <div class="dd-auth__card">
    <h1 class="dd-auth__title">Log in</h1>

    <%= simple_form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
      <%= f.input :email,
                  required: false,
                  autofocus: true,
                  input_html: { autocomplete: "email", inputmode: "email" } %>
      <%= f.input :password,
                  required: false,
                  input_html: { autocomplete: "current-password" } %>
      <%= f.input :remember_me, as: :boolean if devise_mapping.rememberable? %>

      <%= f.button :submit, "Log in", class: "btn btn-primary w-100 dd-auth__submit" %>
    <% end %>

    <div class="dd-auth__links">
      <%= render "devise/shared/links" %>
    </div>
  </div>
</div>
