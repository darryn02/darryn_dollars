<div class="dd-flashes" aria-live="polite">
  <% user_facing_flashes.each do |key, value| %>
    <div class="dd-flash dd-flash--<%= key %> fade-in-down-out" role="alert">
      <%= icon(%w[alert error].include?(key) ? "exclamation-triangle-fill" : "check-circle-fill") %>
      <div><%= value %></div>
    </div>
  <% end %>

  <div class="dd-flash flash-from-js" role="alert"></div>
</div>
