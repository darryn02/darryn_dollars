.history
  %h1.dd-page-title History

  - if @wagers_by_account.keys.many?
    %nav.dd-account-tabs#account-tabs{ role: "tablist", "aria-label" => "Accounts" }
      - @wagers_by_account.each_with_index do |(account, wagers), index|
        - tab_name = current_user.admin? ? account.qualified_name : account.to_s
        %button.dd-account-tab{ id: "account-#{account.id}-tab",
          class: (index.zero? ? "active" : ""),
          data: { bs_toggle: "tab", bs_target: "#account-#{account.id}-tab-pane" },
          type: "button", role: "tab",
          "aria-controls" => "account-#{account.id}-tab-pane",
          "aria-selected" => (index.zero? ? "true" : "false") }= tab_name
    .tab-content#account-tabs-content
      - @wagers_by_account.each_with_index do |(account, wagers), index|
        .tab-pane.fade{ id: "account-#{account.id}-tab-pane",
          class: (index.zero? ? "show active" : ""), role: "tabpanel",
          "aria-labelledby" => "account-#{account.id}-tab", tabindex: "0" }
          = render "account_history", account: account, wagers: wagers
  - else
    - account, wagers = @wagers_by_account.first
    - if account.present?
      = render "account_history", account: account, wagers: wagers
    - else
      .blank-state
        = icon "clock-history"
        %h2 Nothing to see here
        %p Come back after you've won or lost something.
