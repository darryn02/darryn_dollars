.dd-slip.dd-slip--pending.pending-bet-slip
  -# The avatar and tint only appear where there is a sibling slip to
  -# confuse this one with. The left border still says pending or confirmed.
  .dd-slip__header{ class: (account_color_class(bet_slip.account) if bet_slip.show_avatar?) }
    - if bet_slip.show_avatar?
      = account_avatar(bet_slip.account)
    .dd-slip__heading
      %h2.dd-slip__title= bet_slip.title
      %p.dd-slip__summary
        %span= pluralize(bet_slip.wagers.size, "wager")
        %span.dd-slip__dot &middot;
        %span= "#{currency(bet_slip.wagers.sum(&:amount))} at risk"
        %span.dd-slip__dot &middot;
        %span= "#{currency(bet_slip.wagers.sum(&:potential_profit))} to win"

  %ul.dd-slip__list
    - bet_slip.wagers.each do |wager|
      %li.dd-slip__row{ id: "pending-wager-#{wager.id}" }
        .dd-slip__bet
          %span.dd-slip__bet-line= wager_line_label(wager.line)
          %span.dd-slip__bet-meta= line_terms(wager.line)
          = vig_waived_badge(wager)
          -# A bet added under the wrong account is put right here, while it
          -# is still pending, rather than deleted and found again.
          - bet_slip.move_targets.each do |target|
            = link_to "Move to #{target.display_name}",
              move_wager_path(wager, account_id: target.id),
              method: :patch, class: "dd-slip__move"
        .dd-slip__figures
          %span.dd-slip__stake= currency(wager.amount)
          %span.dd-slip__towin= "to win #{currency(wager.potential_profit)}"
        = link_to wager_path(wager),
          method: :delete,
          remote: true,
          data: { confirm: "Delete this wager?" },
          class: "dd-slip__remove",
          "aria-label" => "Remove #{wager_line_label(wager.line)}" do
          = icon "x-lg"

  .dd-slip__actions
    = link_to bet_slip.confirm_label,
      confirm_pending_wagers_path(account_id: bet_slip.account.id),
      method: :post,
      class: "btn btn-primary dd-slip__confirm"
    = link_to "Cancel all",
      cancel_pending_wagers_path(account_id: bet_slip.account.id),
      method: :delete,
      data: { confirm: "Cancel #{bet_slip.wagers.size} wager(s)?" },
      class: "btn dd-slip__cancel"
