.dd-slip.dd-slip--pending.pending-bet-slip
  .dd-slip__header
    %h2.dd-slip__title= bet_slip.title
    %p.dd-slip__summary
      %span= pluralize(bet_slip.wagers.size, "wager")
      %span.dd-slip__dot &middot;
      %span= "#{currency(bet_slip.wagers.sum(&:amount))} at risk"
      %span.dd-slip__dot &middot;
      %span= "#{currency(bet_slip.wagers.sum(&:potential_profit))} to win"

  %ul.dd-slip__list
    - bet_slip.wagers.each do |wager|
      %li.dd-slip__row{ id: "pending-wager-#{wager.id}" }
        .dd-slip__bet
          %span.dd-slip__bet-line= wager_line_label(wager.line)
          %span.dd-slip__bet-meta= line_terms(wager.line)
          = vig_waived_badge(wager)
        .dd-slip__figures
          %span.dd-slip__stake= currency(wager.amount)
          %span.dd-slip__towin= "to win #{currency(wager.potential_profit)}"
        = link_to wager_path(wager),
          method: :delete,
          remote: true,
          data: { confirm: "Delete this wager?" },
          class: "dd-slip__remove",
          "aria-label" => "Remove #{wager_line_label(wager.line)}" do
          = icon "x-lg"

  .dd-slip__actions
    = link_to "Confirm #{pluralize(bet_slip.wagers.size, 'wager')}",
      confirm_pending_wagers_path,
      method: :post,
      class: "btn btn-primary dd-slip__confirm"
    = link_to "Cancel all",
      cancel_pending_wagers_path,
      method: :delete,
      data: { confirm: "Cancel #{bet_slip.wagers.size} wager(s)?" },
      class: "btn dd-slip__cancel"
