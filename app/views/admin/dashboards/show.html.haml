%h1.dd-page-title Admin

.dd-admin-section
  %h2.dd-eyebrow Fetch lines
  %p.dd-admin-note One fetch brings back game, first half and second half together.
  .dd-admin-actions
    - [["NFL", :nfl], ["NCAAF", :ncaaf]].each do |label, sport|
      = link_to "#{label} Lines",
        fetch_lines_admin_dashboard_path(sport: sport),
        remote: true,
        class: "dd-admin-btn dd-admin-btn--fetch"

.dd-admin-section
  %h2.dd-eyebrow Scores and scoring
  .dd-admin-actions
    = link_to "NFL Scores", fetch_scores_admin_dashboard_path(sport: :nfl),
      remote: true, class: "dd-admin-btn dd-admin-btn--score"
    = link_to "NCAAF Scores", fetch_scores_admin_dashboard_path(sport: :ncaaf),
      remote: true, class: "dd-admin-btn dd-admin-btn--score"
    = link_to "Score Lines", score_lines_admin_dashboard_path,
      remote: true, class: "dd-admin-btn dd-admin-btn--score"
    = link_to "Score Wagers", score_wagers_admin_dashboard_path,
      remote: true, class: "dd-admin-btn dd-admin-btn--score"

.dd-admin-section
  %h2.dd-eyebrow Waive the vig
  %p.dd-admin-note Caps a loss at what a win would have paid - works on a bet that already settled too.
  .dd-admin-actions
    = link_to "Waive the Vig", new_admin_vig_waiver_path, class: "dd-admin-btn dd-admin-btn--score"

.dd-panel
  .dd-panel__header
    %h2.dd-panel__title Account Summary
  .dd-table-scroll
    %table.table.table-sm.align-middle.mb-0
      %thead
        %tr
          %th Account
          %th.text-end.text-nowrap Winnings
          %th.text-end.text-nowrap Payments
          %th.text-end.text-nowrap Balance
      %tbody
        - @accounts.each do |account|
          %tr
            %td
              .dd-table-name= account.qualified_name
              .dd-table-subtext= last_seen_label(account.user)
            %td.text-end.text-nowrap= currency(account.winnings)
            %td.text-end.text-nowrap= currency(account.payment_sum)
            %td.text-end.text-nowrap= currency(account.balance)
      %tfoot
        %tr.dd-table-total
          %th Totals
          %td.text-end.text-nowrap{ class: (@accounts.sum(&:winnings) < 0 ? "is-up" : "is-down") }= currency(-1 * @accounts.sum(&:winnings))
          %td.text-end.text-nowrap= currency(-1 * @accounts.sum(&:payment_sum))
          %td.text-end.text-nowrap{ class: (@accounts.sum(&:balance) < 0 ? "is-up" : "is-down") }= currency(-1 * @accounts.sum(&:balance))

.dd-panel
  .dd-panel__header
    %h2.dd-panel__title Enter Payment
  .dd-panel__body
    .payment-form
      = simple_form_for([:admin, Payment.new]) do |f|
        = f.input :account_id, collection: Account.all, label_method: :qualified_name, value_method: :id
        = f.input :amount, as: :string, input_html: { inputmode: "decimal", data: { type: "currency" } }
        = f.submit "Submit", class: "btn btn-primary w-100 mt-2"
